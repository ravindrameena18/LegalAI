# Runtime
APP_ENV=development
WEB_ORIGIN=http://localhost:3000
# API_ORIGIN: Server-side upstream backend for Next.js proxy route (/api/[...path]).
# In production on Render (frontend service): API_ORIGIN=https://legalai-api-dqmg.onrender.com
# In local development: API_ORIGIN=http://localhost:8000
API_ORIGIN=http://localhost:8000
# Backend CORS allowed origins (FastAPI):
CORS_ORIGINS=http://localhost:3000,https://legalai-jyad.onrender.com

# Persistence
DATABASE_URL=postgresql://legalai:change-me@localhost:5432/legalai
REDIS_URL=redis://localhost:6379/0

# Server secrets: generate unique values locally; never commit real secrets.
JWT_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-a-32-byte-key

# Private S3-compatible object storage
STORAGE_PROVIDER=unconfigured
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=legalai-private
STORAGE_ACCESS_KEY=replace-me
STORAGE_SECRET_KEY=replace-me

# AI provider boundary (server-side only)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional OCR boundary
OCR_PROVIDER=unconfigured
OCR_API_KEY=

# Optional email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.invalid
